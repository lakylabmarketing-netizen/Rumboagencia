      "id": "054eb795-f76a-4856-a817-0e1727190e90",
      "name": "Responder challenge de Meta",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        260,
        790
      ]
    },
    {
      "parameters": {
        "jsCode": "// Normaliza los mensajes entrantes de WhatsApp, Instagram y Facebook Messenger\n// a un formato común: { platform, senderId, text, phoneNumberId }\nconst out = [];\n\nfor (const item of $input.all()) {\n  const j = item.json;\n\n  // --- WhatsApp (salida del WhatsApp Trigger) ---\n  const wa = j.messages ? j : (j.entry?.[0]?.changes?.[0]?.value || null);\n  if (wa && wa.messages) {\n    for (const m of wa.messages) {\n      if (m.type !== 'text') continue;\n      out.push({ json: {\n        platform: 'whatsapp',\n        senderId: m.from,\n        senderName: wa.contacts?.[0]?.profile?.name || '',\n        text: m.text.body,\n        phoneNumberId: wa.metadata?.phone_number_id,\n      }});\n    }\n    continue;\n  }\n\n  // --- Instagram / Messenger (Webhook de Meta) ---\n  const body = j.body || {};\n  const platform = body.object === 'instagram' ? 'instagram' : 'facebook';\n  for (const entry of body.entry || []) {\n    for (const ev of entry.messaging || []) {\n      // Ignora ecos (mensajes enviados por la propia página) y mensajes sin texto\n      if (!ev.message || ev.message.is_echo || !ev.message.text) continue;\n      out.push({ json: {\n        platform,\n        senderId: ev.sender.id,\n        senderName: '',\n        text: ev.message.text,\n        phoneNumberId: null,\n      }});\n    }\n  }\n}\n\nreturn out;"
      },
      "id": "a1e23517-6d2a-4569-bce8-d6dda1069d0e",
