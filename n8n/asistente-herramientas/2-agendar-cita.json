    {
      "parameters": {
        "jsCode": "// Calcula inicio y fin de la cita (30 minutos por defecto)\nconst DURACION_MIN = 30;\nconst d = $input.first().json;\nconst inicio = DateTime.fromISO(d.fecha_hora, { zone: $env.GENERIC_TIMEZONE || 'Europe/Madrid' });\nif (!inicio.isValid) {\n  return [{ json: { ...d, valida: false, error: 'Fecha no válida. Pide al cliente día y hora (ej: 2026-10-05 10:00).' } }];\n}\nreturn [{ json: { ...d, valida: true, inicio: inicio.toISO(), fin: inicio.plus({ minutes: DURACION_MIN }).toISO() } }];"
      },
      "id": "76fd50d2-672e-4282-910f-db00cffcec8a",
      "name": "Calcular horario",
      "type": "n8n-nodes-base.code",
