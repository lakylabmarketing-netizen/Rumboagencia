# Copia este archivo a .env y rellena lo que uses
ANTHROPIC_API_KEY=
MODEL=claude-sonnet-5-5
# Token del panel (si lo dejas vacio se genera uno al iniciar)
APP_TOKEN=

# Correo (IMAP/SMTP). Gmail: usa "contrasena de aplicacion"
EMAIL_ADDRESS=
EMAIL_PASSWORD=
IMAP_HOST=imap.gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# WhatsApp Business Cloud API (Meta)
WA_TOKEN=
WA_PHONE_ID=
WA_VERIFY_TOKEN=cambia-esto

# Llamadas (Twilio): Jarvis te llama cuando estas ocupado y algo es urgente
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
MY_PHONE=

# full = Jarvis actua sin preguntar | readonly = solo lee y abre apps
AUTONOMY=full
